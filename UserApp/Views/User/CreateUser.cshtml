@model UserApp.Models.User

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8 col-md-10">

            <div class="card border-0 shadow-lg rounded-4">

                <!-- Header -->
                <div class="card-header bg-white border-0 pt-4 pb-0 px-4">
                    <h2 class="fw-bold mb-1">Create New User</h2>
                    <p class="text-muted mb-0">
                        Add a new user to your management system
                    </p>
                </div>

                <!-- Body -->
                <div class="card-body p-4">

                    <div asp-validation-summary="All" class="alert alert-danger"></div>

                    <form asp-action="CreateUser" asp-controller="User" method="post">

                        <div class="row">

                            <!-- Username -->
                            <div class="col-md-6 mb-4">
                                <label asp-for="UserName" class="form-label fw-semibold">
                                    User Name
                                </label>

                                <input asp-for="UserName"
                                       class="form-control form-control-lg rounded-3"
                                       placeholder="Enter user name" />

                                <span asp-validation-for="UserName" class="text-danger small"></span>
                            </div>

                            <!-- Email -->
                            <div class="col-md-6 mb-4">
                                <label asp-for="Email" class="form-label fw-semibold">
                                    Email Address
                                </label>

                                <input asp-for="Email"
                                       class="form-control form-control-lg rounded-3"
                                       placeholder="Enter email address" />

                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                        </div>

                        <div class="row">

                            <!-- Password -->
                            <div class="col-md-6 mb-4">
                                <label asp-for="Password" class="form-label fw-semibold">
                                    Password
                                </label>

                                <input asp-for="Password"
                                       type="password"
                                       class="form-control form-control-lg rounded-3"
                                       placeholder="Enter password" />

                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <!-- Phone -->
                            <div class="col-md-6 mb-4">
                                <label asp-for="PhoneNumber" class="form-label fw-semibold">
                                    Phone Number
                                </label>

                                <input asp-for="PhoneNumber"
                                       class="form-control form-control-lg rounded-3"
                                       placeholder="Enter phone number" />

                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>

                        </div>

                        <!-- Address -->
                        <div class="mb-4">
                            <label asp-for="Address" class="form-label fw-semibold">
                                Address
                            </label>

                            <textarea asp-for="Address"
                                      rows="3"
                                      class="form-control rounded-3"
                                      placeholder="Enter address"></textarea>

                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex gap-3">

                            <button type="submit"
                                    class="btn btn-primary px-4 py-2 rounded-3 fw-semibold">
                                Save User
                            </button>

                            <a asp-action="UserIndex"
                               class="btn btn-outline-secondary px-4 py-2 rounded-3 fw-semibold">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>