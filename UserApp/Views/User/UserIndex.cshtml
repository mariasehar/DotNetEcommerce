@using UserApp.Models
@model List<User>

<div class="container-fluid py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-0">Users</h3>
            <small class="text-muted">Manage your Users</small>
        </div>

        <a asp-action="CreateUser"
           class="btn btn-primary px-4 py-2 shadow-sm rounded-3">
            + Add User
        </a>

    </div>

    <!-- CARD -->
    <div class="card border-0 shadow-sm rounded-4">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0 table-fixed">

                    <!-- TABLE HEADER -->
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3">Name</th>
                            <th class="py-3">Email</th>
                            <th class="py-3">Password</th>
                            <th class="py-3">Phone Number</th>
                            <th class="py-3">Address</th>
                            <th class="text-center py-3 pe-4">Actions</th>
                        </tr>
                    </thead>

                    <!-- TABLE BODY -->
                    <tbody>

                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    No users available
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <!-- NAME -->
                                    <td class="ps-4 fw-semibold text-dark text-truncate"
                                        style="max-width: 180px;">
                                        @item.UserName
                                    </td>

                                    <!-- EMAIL -->
                                    <td class="text-success fw-semibold text-truncate"
                                        style="max-width: 200px;">
                                        @item.Email
                                    </td>

                                    <!-- PASSWORD -->
                                    <td class="text-truncate"
                                        style="max-width: 150px;">
                                        @item.Password
                                    </td>

                                    <!-- PHONE (FIXED) -->
                                    <td class="text-nowrap">
                                        @item.PhoneNumber
                                    </td>

                                    <!-- ADDRESS -->
                                    <td class="text-truncate"
                                        style="max-width: 220px;">
                                        @item.Address
                                    </td>

                                    <!-- ACTIONS (FIXED SIDE BY SIDE) -->
                                    <td class="text-center pe-4">
                                        <div class="d-flex justify-content-center gap-2 flex-nowrap">

                                            <a asp-action="EditUser"
                                               asp-route-id="@item.UserId"
                                               class="btn btn-sm btn-outline-warning rounded-3 px-3">
                                                Edit
                                            </a>

                                            <a asp-action="DeleteUser"
                                               asp-route-id="@item.UserId"
                                               class="btn btn-sm btn-outline-danger rounded-3 px-3">
                                                Delete
                                            </a>

                                        </div>
                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
