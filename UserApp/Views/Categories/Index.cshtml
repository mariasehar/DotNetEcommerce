@using UserApp.Models.Categories
@model List<Category>

<div class="flex-1 p-4"></div>
<div class=" container mt-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Category Management</h2>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            + Add Category
        </a>
    </div>

    <!-- Card -->
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-body">

            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width: 30%">Category Name</th>
                        <th style="width: 50%">Description</th>
                        <th style="width: 20%" class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted">
                                No categories found
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.CategoryName</td>
                                <td class="text-muted">@item.Description</td>
                                <td class="text-center">

                                    <a asp-action="Edit" asp-route-CategoryId="@item.CategoryId"
                                       class="btn btn-sm btn-warning me-1">
                                        Edit
                                    </a>

                                    <a asp-action="Delete" asp-route-CategoryId="@item.CategoryId"
                                       class="btn btn-sm btn-danger">
                                        Delete
                                    </a>

                                </td>
                            </tr>
                        }
                    }
                </tbody>

            </table>

        </div>
    </div>

</div></div>