@using UserApp.Models.Products
@model Product

<div class="container mt-5">
    <h3 class="text-danger">Are you sure you want to delete this?</h3>

    <div class="card p-3 mt-3">
        <h4>Product Name:</h4>
        <p>@Model.ProductName</p>
       
    </div>

    <form asp-action="DeleteProduct" method="post">
        <input type="hidden" asp-for="ProductId" />

        <button type="submit" class="btn btn-danger mt-3">Delete</button>
        <a asp-action="ProductIndex" class="btn btn-secondary mt-3">Cancel</a>
    </form>
</div>